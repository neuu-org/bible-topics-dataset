message: "If you use this dataset, please cite it as below."
title: "Bible Topics Dataset"
type: dataset
authors:
  - name: "NEUU"
    website: "https://github.com/neuu-org"
license: CC-BY-4.0
repository-code: "https://github.com/neuu-org/bible-topics-dataset"
version: 1.1.0
date-released: "2026-03-16"
abstract: >-
  5,745 biblical topics unified from two classic topical reference works:
  Nave's Topical Bible (1896) and Torrey's New Topical Textbook (1897).
  Part of the NEUU biblical scholarship ecosystem.
keywords:
  - bible
  - topical-bible
  - dataset
  - nave
  - torrey
  - biblical-studies
references:
  - type: unpublished
    title: "Nave's Topical Bible"
    authors:
      - name: "Orville J. Nave"
    year: 1896
  - type: unpublished
    title: "Torrey's New Topical Textbook"
    authors:
      - name: "R. A. Torrey"
    year: 1897
